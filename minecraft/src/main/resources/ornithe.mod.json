{
  "schemaVersion": 1,
  "id": "zordyx_client_v1",
  "name": "Zordyx Client (Platform Module)",
  "version": "${mod_version}",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "Zordyx",
    "Polyfrost"
  ],
  "contact": {
    "homepage": "https://github.com/notdeathlyatall/Zordyx-Client",
    "sources": "https://github.com/notdeathlyatall/Zordyx-Client",
    "issues": "https://github.com/notdeathlyatall/Zordyx-Client/issues"
  },
  "license": "LGPL-3.0",
  "environment": "client",
  "accessWidener": "zordyx_client.classtweaker",
  "mixins": [
    "mixins.zordyx_client.init.json",
    "mixins.zordyx_client.json"
  ],
  "entrypoints": {
    "client": [
      "org.polyfrost.oneconfig.internal.OneConfig"
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.oneconfig.internal.compat.ModMenuEntrypoint"
      }
    ],
    "preLaunch": [
      "org.polyfrost.oneconfig.internal.SkikoDataPathPreLaunch"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_mc_version}",
    "pylon": ">=0.1.7",
    "osl-core": ">=0.10.0",
    "osl-config": ">=0.6.2",
    "osl-localization": ">=0.1.1",
    "osl-networking": ">=0.10.0",
    "osl-resource-loader": ">=0.8.0",
    "osl-text-components": ">=0.1.0-alpha.5"
  },
  "custom": {
    "modmenu": {
      "parent": "zordyx_client",
      "badges": [ "library" ]
    }
  }
}
