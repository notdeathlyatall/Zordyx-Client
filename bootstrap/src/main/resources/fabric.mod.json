{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Zordyx Client",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "Zordyx",
    "Polyfrost"
  ],
  "contact": {
    "homepage": "https://github.com/notdeathlyatall/Zordyx-Client",
    "sources": "https://github.com/notdeathlyatall/Zordyx-Client",
    "issues": "https://github.com/notdeathlyatall/Zordyx-Client/issues"
  },
  "icon": "zordyx-icon.png",
  "provides": [
    "oneconfig",
    "oneconfigbootstrap"
  ],
  "license": "LGPL-3.0",
  "environment": "client",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${mc_version}",
    "zordyx_client_v1": "${mod_version}",
    "compose-multiplatform": ">=${compose_version}",
    "fabric-language-kotlin": ">=${flk_version}"
  },
  "breaks": {
    "polyplus": "<1.2.49"
  }
}
